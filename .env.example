# ==== App ====
NODE_ENV=development
PORT=3000

# ==== Database ====
# DATABASE_SSL: true면 ssl 옵션 적용(Supabase 등), false면 ssl 미적용(로컬 Docker 등)
# [예시 1] Supabase Postgres — 직접 연결 문자열, SSL 필수
# DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres?sslmode=require
# DATABASE_SSL=true
# [예시 2] 로컬 Docker PostgreSQL — SSL 없음
# DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
# DATABASE_SSL=false
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres?sslmode=require
DATABASE_SSL=true

# ==== CORS ====
# 콤마로 구분된 허용 origin 목록 (비어있으면 전체 거부)
ALLOWED_ORIGINS=http://localhost:3000

# ==== Swagger (코드 기본값은 false, 로컬 개발 편의를 위해 예시는 true) ====
SWAGGER_ENABLED=true

# ==== NAVER API HUB (뉴스 검색) — placeholder, 아직 연동 안 함 ====
NAVER_APIHUB_KEY_ID=
NAVER_APIHUB_KEY=
