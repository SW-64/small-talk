# ==== App ====
NODE_ENV=development
PORT=3000

# ==== Database ====
# DATABASE_SSL: true면 ssl 옵션 적용(Supabase 등), false면 ssl 미적용(로컬 Docker 등)
# [예시 1] Supabase Postgres — 직접 연결 문자열, SSL 필수
# DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres?sslmode=require
# DATABASE_SSL=true
# [예시 2] 로컬 Docker PostgreSQL — SSL 없음
# DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
# DATABASE_SSL=false
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres?sslmode=require
DATABASE_SSL=true

# ==== CORS ====
# 콤마로 구분된 허용 origin 목록 (비어있으면 전체 거부)
ALLOWED_ORIGINS=http://localhost:3000

# ==== Swagger (코드 기본값은 false, 로컬 개발 편의를 위해 예시는 true) ====
SWAGGER_ENABLED=true

# ==== NAVER API HUB (뉴스 검색) ====
# 필수값. 개발용 GET /api/news/sample, POST /api/v1/dev/trend-issues
# (NODE_ENV=development 에서만 등록) 에서 사용. 실제 키는 .env 에만 넣고 커밋하지 말 것
NAVER_APIHUB_KEY_ID=
NAVER_APIHUB_KEY=

# ==== Google Gemini (이슈 카드 3줄 요약·스몰토크 생성) ====
# 개발용 POST /api/v1/dev/issue-cards 에서 사용. 실제 키는 .env 에만 넣을 것
GOOGLE_API_KEY=
# 생략하면 gemini-3.8-flash
GEMINI_MODEL=
